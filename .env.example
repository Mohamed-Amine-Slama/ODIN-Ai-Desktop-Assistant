# Rename this file to .env and fill in your values

# Any endpoint that speaks the OpenAI chat-completions protocol works.
# Pick one of these three and delete the rest.

# Google Gemini - key from https://aistudio.google.com/apikey

# AgentRouter (agentrouter.org) was tried here and does NOT work for Jarvis:
# it runs a WAF that only accepts requests matching the actual Claude Code
# CLI's exact request fingerprint and rejects every other client (generic
# OpenAI SDK, generic Anthropic SDK) with 401 "unauthorized client detected"
# regardless of whether the API key itself is valid. Spoofing that fingerprint
# to get past it would mean impersonating another application to obtain
# access the provider has deliberately restricted, so this key is not usable
# here.
#
# OpenRouter's free tier on nvidia/nemotron-nano-12b-v2-vl:free does NOT work
# reliably: live testing on 2026-08-17 showed it failing outright (malformed/
# empty responses) on roughly half of all requests, and even when it did
# respond it would often write a fake pseudo-call as plain text
# ("get_time_date()") instead of a real tool call - which is why every skill
# looked broken. Google Gemini (Jarvis's built-in default) was tried next,
# but that Google Cloud project got a 403 PERMISSION_DENIED requiring a
# billing account, which isn't available here - key/config left below,
# commented out, in case that changes.
#
# nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free on OpenRouter worked
# live (4/4, then 3/5 with the "misses" being reasonable clarifying
# questions, not hallucinations) and was the confirmed-working config for a
# while. anthropic/claude-haiku-4.5 on OpenRouter scored a clean 9/9, but
# that OpenRouter key turned out to have far less real balance than expected
# (rejected an 8192-max_tokens request as unaffordable). AWS Bedrock (real
# $120 credits, bearer-token auth confirmed working, listed 15 Claude
# models) hit "Access to Anthropic models is not allowed from unsupported
# countries, regions, or territories" on every single call, and the same
# account's OpenAI-hosted-on-Bedrock models hit the same wall too - an
# AWS-account-level eligibility restriction, not fixable in code. All of
# those are parked below in case any of those situations change.
#
# Settled on DashScope (Alibaba Cloud) / Qwen3.8-Max instead: this is
# ODIN's own built-in DASHSCOPE_* provider path (config.py's _first_env
# chain), so needed zero code changes. Scored a clean 9/9 on live
# tool-calling trials against the real 42-tool system prompt - the best
# result of everything tried today - on a real account with real free
# credits, no shared-pool congestion and no billing/country wall.

API_KEY=your_api_key_here
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-3.6-flash

# OpenRouter - one key, hundreds of models
# BASE_URL=https://openrouter.ai/api/v1
# MODEL=meta-llama/llama-3.3-70b-instruct

# Anthropic - selected automatically when MODEL names a Claude
# BASE_URL=
# MODEL=claude-opus-5

# Amazon Bedrock - needs `pip install "anthropic[bedrock]"` (already in
# requirements.txt). Auth is an AWS Bedrock API key (bearer token, from the
# Bedrock console) rather than an IAM access-key/secret pair; boto3 reads it
# straight from AWS_BEARER_TOKEN_BEDROCK, nothing else references it.
# Newer Claude models on Bedrock generally need the region-prefixed
# cross-region inference profile id, not the bare model id - check the
# Bedrock console's Model catalog for the exact ids your account can see.
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key
# AWS_REGION=us-east-1
# MODEL=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0

# Reasoning depth: low | medium | high, or "off" for models with no reasoning
# control. "low" keeps a voice assistant snappy - fewer, more consolidated tool
# calls and terser replies. A model that rejects the parameter is detected on
# the first turn and it is dropped for the session.
EFFORT=low

# Ceiling on thinking + response tokens combined. Not a target length.
MAX_TOKENS=8192
MAX_HISTORY_MESSAGES=80
MEMORY_CONTEXT_LIMIT=5

# "voice" or "text" - can be changed at runtime with the /mode command
DEFAULT_MODE=text

# Name Jarvis responds to / announces itself as
ASSISTANT_NAME=ODIN

# Ask before shutting down, restarting, or killing processes. Leave this on.
# Speech-to-text mishears; a misrecognised "shut down" shouldn't power off
# your machine. Anything other than a clear "yes" is treated as no.
CONFIRM_DESTRUCTIVE=1

# Print token usage and cache hit rates after each turn
DEBUG=0

# --- System access --------------------------------------------------------
# Kill switches. Set either to 0 to remove that whole tool group from the
# model's reach — the skill stops being registered at all, so it can't be
# called by mistake or by a prompt injection in a file Jarvis reads.
ENABLE_SHELL=1
ENABLE_INPUT_CONTROL=1

# How long an action stays undoable with /undo.
UNDO_WINDOW_SECONDS=900

# Hand-gesture cursor control (core/gesture.py) - point to move, pinch to
# click/drag/right-click, two fingers to scroll. Off by default: this
# activates a webcam, so it's opt-in unlike the flags above. Turn on with
# the HUD/tray toggle or by asking to "turn on hand control" (the latter
# asks for confirmation first, like any other DANGEROUS action).
ENABLE_GESTURE_CONTROL=0
GESTURE_CAMERA_INDEX=0
GESTURE_FPS_LIMIT=30
GESTURE_SMOOTHING=0.5
GESTURE_CLICK_HOLD_MS=250

# DOM-driven browser automation (core/browser.py) - opens a real, visible
# browser and drives web pages by element instead of by pixel, which is far
# faster than screenshot-and-click for anything you need to DO on a site. Off
# by default: it needs an install step pip alone doesn't cover -
#   pip install playwright && playwright install chrome
# The tools stay unregistered until BOTH the flag is on and the package is
# installed. The browser keeps its own profile under data/browser_profile/,
# so you log in by hand once and it remembers.
ENABLE_BROWSER_AUTOMATION=0
# "chrome" drives the real Chrome you already have; "" (or a channel that
# isn't installed) falls back to the Chromium Playwright bundles.
BROWSER_CHANNEL=chrome
BROWSER_NAV_TIMEOUT_SECONDS=30
BROWSER_ACTION_TIMEOUT_SECONDS=15
# How many interactive elements one browser_read lists.
BROWSER_MAX_ELEMENTS=60

# Deleted and overwritten files are copied to data/trash first. These bound
# how much of it is kept; pruning runs at startup.
TRASH_MAX_ENTRIES=200
TRASH_MAX_AGE_DAYS=7

# --- Instrument HUD (see ODIN-HUD.md) --------------------------------------
HUD_TELEMETRY_INTERVAL_MS=1000
HUD_DISK_POLL_SECONDS=15

# City for the weather panel, e.g. "London". Empty auto-locates from your IP.
WEATHER_CITY=
HUD_WEATHER_POLL_SECONDS=600

# Audio spectrum source: loopback (what's playing) | mic | off. Falls back to
# a pseudo-random idle animation if the chosen source isn't available.
HUD_SPECTRUM_SOURCE=loopback

# Skip the boot animation and ring/orb motion; keep value transitions.
HUD_REDUCED_MOTION=0

# --- Voice ------------------------------------------------------------------

# Wake trigger: say the assistant's name (ASSISTANT_NAME below) and "wake up"
# to bring it back from sleep - works with any name, no API key, no training.
# Set to "off" for push-to-talk (press Enter, then speak).
WAKE_WORD=on

# Local speech-to-text. base.en is a solid CPU default; small.en is more
# accurate if your machine can take it. Weights download on first run.
STT_MODEL=base.en

# "auto" for both lets CTranslate2 pick the fastest device+precision this
# machine supports - an NVIDIA GPU (float16 or better) when one's usable,
# CPU int8 otherwise. This is what makes STT fast instead of a source of lag.
# Force STT_DEVICE=cuda only to troubleshoot (a GPU that isn't actually
# usable then raises a clear error instead of silently falling back).
# Options: STT_DEVICE = auto | cpu | cuda
STT_DEVICE=auto
STT_COMPUTE=auto

# Text-to-speech. "auto" prefers edge-tts (natural, free, no key, needs
# network) and falls back to offline Windows SAPI voices.
# Options: auto | edge | sapi | off
TTS_ENGINE=auto
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=180

# Stop recording after this much silence; never record longer than max.
VAD_SILENCE_SECONDS=0.8
VAD_MAX_SECONDS=20

# Interrupt Jarvis mid-sentence by talking over it. RMS energy level that
# counts as "the user is talking" - no acoustic echo cancellation, so raise
# this if Jarvis's own voice through open speakers ever triggers it.
BARGE_IN_THRESHOLD=0.05

# --- Security -----------------------------------------------------------
# Scans file reads, shell command output, and web fetches for things that
# look like API keys/passwords/tokens before they reach the model, get
# spoken, or get persisted to the conversation log.
# off | warn (log only) | redact (mask matches, default) | block (withhold)
SECURITY_SCAN_MODE=redact

# Throttle on web_fetch/http_request/get_news - same limit no matter who
# triggered the call, so a runaway or prompt-injected loop can't hammer a
# target unattended. Set RATE_LIMIT_PER_MINUTE=0 to disable.
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_BURST=10

# --- Remote channels ------------------------------------------------------
# Telegram bridge - text the assistant from your phone and get replies back.
# 1. Message @BotFather on Telegram, send /newbot, and paste the token here.
# 2. Restart, then message your new bot once - it replies with the chat id
#    to paste into TELEGRAM_CHAT_ID below (locks the bot to just that chat).
# 3. Restart again. Destructive actions are always auto-declined from this
#    channel - there's nobody there to confirm them.
# TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
# TELEGRAM_CHAT_ID=

# Discord bridge - same idea, over Discord instead. Needs the optional
# discord.py package (already in requirements.txt).
# 1. Create an app + bot at discord.com/developers/applications, enable the
#    "Message Content Intent" under Bot settings, paste the bot token here,
#    and invite it to a server (or DM it directly).
# 2. Restart, then message the bot once - it replies with the channel id to
#    paste into DISCORD_CHANNEL_ID below (locks the bot to just that channel).
# 3. Restart again. Same auto-decline rule as Telegram above.
# DISCORD_BOT_TOKEN=your_bot_token
# DISCORD_CHANNEL_ID=

# --- News / RSS -------------------------------------------------------------
# get_news skill: comma-separated feed URLs to use when the request doesn't
# name a specific feed. Optional - well-known names ("hacker news", "bbc",
# "the verge", ...) and explicit feed URLs work without this being set.
# RSS_FEEDS=https://news.ycombinator.com/rss,https://feeds.bbci.co.uk/news/rss.xml

# --- Optional skills --------------------------------------------------------

# web_search needs nothing here - it works out of the box via the ddgs
# package (DuckDuckGo, no key, no signup, already in requirements.txt).
# deep_learn additionally needs its local storage packages to be installed
# (sentence-transformers, chromadb - already in requirements.txt).

# Email/calendar - see README section 9 for how to register each OAuth app;
# MS_OAUTH_TENANT_ID only needs setting if "common" isn't right for your
# Microsoft account type.
# MS_OAUTH_CLIENT_ID=your_azure_app_client_id
# MS_OAUTH_TENANT_ID=common
