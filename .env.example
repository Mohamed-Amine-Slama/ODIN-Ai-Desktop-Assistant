# Rename this file to .env and fill in your values

# Alibaba Cloud Model Studio / DashScope Example:
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_BASE_URL=https://ws-9d8j0kij8zcohu23.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
DASHSCOPE_MODEL=qwen-max
LLM_PROVIDER=openai

# OpenRouter Example:
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Reasoning depth: low | medium | high | xhigh | max
# "low" keeps a voice assistant snappy - fewer, more consolidated tool calls
# and terser replies. Raise it if Jarvis starts under-thinking hard requests.
EFFORT=low

# Ceiling on thinking + response tokens combined. Not a target length.
MAX_TOKENS=8192

# "voice" or "text" - can be changed at runtime with the /mode command
DEFAULT_MODE=text

# Name Jarvis responds to / announces itself as
ASSISTANT_NAME=Jarvis

# Ask before shutting down, restarting, or killing processes. Leave this on.
# Speech-to-text mishears; a misrecognised "shut down" shouldn't power off
# your machine. Anything other than a clear "yes" is treated as no.
CONFIRM_DESTRUCTIVE=1

# Print token usage and cache hit rates after each turn
DEBUG=0

# --- Voice (needs requirements-voice.txt) ---------------------------------

# Wake word. openWakeWord ships a pretrained "hey_jarvis" model - no API key,
# no training. Set to "off" for push-to-talk (press Enter, then speak).
WAKE_WORD=hey_jarvis
WAKE_THRESHOLD=0.5

# Local speech-to-text. base.en is a solid CPU default; small.en is more
# accurate if your machine can take it. Weights download on first run.
STT_MODEL=base.en
STT_COMPUTE=int8

# Text-to-speech. "auto" prefers edge-tts (natural, free, no key, needs
# network) and falls back to offline Windows SAPI voices.
# Options: auto | edge | sapi | off
TTS_ENGINE=auto
TTS_VOICE=en-GB-RyanNeural
TTS_RATE=180

# Stop recording after this much silence; never record longer than max.
VAD_SILENCE_SECONDS=0.8
VAD_MAX_SECONDS=20
